# OKR-Agent — environment template. Copy to `.env` and fill in the blanks.
#
# WHO READS WHAT
#   * `python -m benchmarks.runner` parses `.env` itself and passes the values to
#     the backend process it starts and to the baseline-arm subprocesses.
#   * `make backend` started by hand does NOT read this file: export it first
#     (`set -a; . ./.env; set +a`).
#   * The MCP tool service (`make mcp`) NEVER reads this file. It needs only the
#     variables in the "MCP tool service" block, exported in its own shell.
#   * `.env` is gitignored. Never commit it; never paste keys into issues.

# ---------------------------------------------------------------------------
# LLM endpoints — backend + baseline arms
# ---------------------------------------------------------------------------
# OpenAI route (OKR·GPT, ReAct-gpt, CrewAI-gpt). Leave the base URL empty to
# use api.openai.com directly, or point it at any OpenAI-compatible endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Anthropic route (OKR·Claude, ReAct-claude, CrewAI-claude). Leave the base URL
# empty for api.anthropic.com. ANTHROPIC_API_KEY is accepted as an alternative.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Model identifiers
# ---------------------------------------------------------------------------
# These are the identifiers recorded in the published run manifests. They were
# served through an OpenAI-/Anthropic-compatible gateway on the study machine;
# set whatever identifiers exist on YOUR endpoint. The runner records the
# effective values in every manifest (`models`).
ATOMAGENTS_OPENAI_MODEL=gpt-5.6-sol
ATOMAGENTS_ANTHROPIC_MODEL=claude-opus-5
ATOMAGENTS_REASONING_EFFORT=high

# ---------------------------------------------------------------------------
# Embeddings (semantic memory recall; OKR-Agent arms only)
# ---------------------------------------------------------------------------
# The campaign used `remote` = text-embedding-3-large (3,072 dimensions) from
# the vendor API. `remote` never falls back silently: a dead endpoint aborts
# the run after turn 1 (0 vectors) instead of quietly downgrading it.
ATOMAGENTS_EMBED_PROVIDER=remote
# REQUIRED whenever OPENAI_BASE_URL points at a chat-only gateway: an empty
# value inherits OPENAI_BASE_URL, and a gateway without /v1/embeddings makes
# every recall fail. Use https://api.openai.com/v1 (or your own endpoint).
ATOMAGENTS_EMBED_BASE_URL=
ATOMAGENTS_EMBED_API_KEY=
ATOMAGENTS_EMBED_MODEL=text-embedding-3-large
# Alternatives: ATOMAGENTS_EMBED_PROVIDER=local (sentence-transformers,
# `pip install -e .[local-embeddings]`) or none (lexical FTS5 recall only).

# ---------------------------------------------------------------------------
# MCP tool service — export these in the shell that runs `make mcp`
# ---------------------------------------------------------------------------
# Optional. Without it `web_search`, `lammps_doc_query` and `fenicsx_doc_query`
# return an error payload (the agents still run).
TAVILY_API_KEY=
# LAMMPS launcher. Auto-detection tries `mpirun -np $ATOMAGENTS_LAMMPS_NP lmp_mpi`
# then serial `lmp`. PIN IT EXPLICITLY: if a conda `mpirun` (MPICH) on PATH
# launches an Open MPI `lmp_mpi` build (Homebrew), you get N independent serial
# copies instead of one parallel run. Example for Homebrew LAMMPS on macOS:
#ATOMAGENTS_LAMMPS_CMD=/opt/homebrew/bin/mpirun -np 12 /opt/homebrew/bin/lmp_mpi
#ATOMAGENTS_LAMMPS_NP=12
# macOS child-process sandbox (sandbox-exec): auto | 1 | 0. See README "Security".
#ATOMAGENTS_SANDBOX_EXEC=auto

# ---------------------------------------------------------------------------
# Benchmark runner (optional overrides)
# ---------------------------------------------------------------------------
# Interpreter for the backend / ReAct arm (default: ./venv/bin/python, else the
# interpreter running the runner).
#OKR_PYTHON=
# Interpreter of the separate CrewAI environment (default:
# benchmarks/crewai-env/.venv/bin/python; see docs/INSTALL.md).
#OKR_CREWAI_PYTHON=
# Root of the runs/ tree the analysis scripts read (default: ../../runs
# relative to the script). The published sessions live in the dataset.
#OKR_RUNS_ROOT=
