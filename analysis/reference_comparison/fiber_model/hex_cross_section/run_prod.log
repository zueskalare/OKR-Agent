unfix f_nvt

# ============================================================
# GAGE STRESS + STRESS-STRAIN SETUP (for deformation segment)
# ============================================================

# Per-atom virial stress (returns -P*V style quantities)
compute stress all stress/atom NULL

# Sum per-atom stress components over gage-mobile atoms
# Components: [1]=xx [2]=yy [3]=zz [4]=xy [5]=xz [6]=yz
compute gage_sum g_gage_mobile reduce sum c_stress[1] c_stress[2] c_stress[3] c_stress[4] c_stress[5] c_stress[6]

# Gage volume as fraction of current box volume
variable gfrac equal 0.92
variable Vgage equal v_gfrac*vol

# Convert summed virial to stress (units real => atm)
variable sxx_gage equal -(c_gage_sum[1])/v_Vgage
variable syy_gage equal -(c_gage_sum[2])/v_Vgage
variable szz_gage equal -(c_gage_sum[3])/v_Vgage

# Reference length for engineering strain
variable Lz0 equal lz
variable strain equal (lz-v_Lz0)/v_Lz0

# Helper variables for output
variable tempv equal temp
variable pzzv  equal pzz

# -----------------------------
# Apply uniaxial tension via fix deform along z
# -----------------------------
fix f_def all deform 1 z erate 2.0e-6 units box remap x

# Thermostat mobile during deformation at 1 K
fix f_nvt2 g_mobile nvt temp 1.0 1.0 100.0

# Dump trajectory (every 1000 steps)
dump d1 all custom 1000 dump.tension.lammpstrj id type x y z xu yu zu

# Stress-strain output (every 100 steps)
# Columns: step strain szz_gage(atm) temp(K) pzz_box(atm)
fix f_ss all ave/time 100 1 100 v_strain v_szz_gage v_tempv v_pzzv file stress_strain_gage.dat

run 20000
