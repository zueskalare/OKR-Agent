# -----------------------------
# Define grip regions (z slabs: [0,20] A and [980,1000] A)
# -----------------------------
region grip_bot block INF INF INF INF 0.0 20.0 units box
region grip_top block INF INF INF INF 980.0 1000.0 units box

group g_bot region grip_bot
552 atoms in group g_bot
group g_top region grip_top
503 atoms in group g_top
group g_mobile subtract all g_bot g_top
36389 atoms in group g_mobile

# -----------------------------
# Define central (gage) region for stress measurement
# -----------------------------
region gage block INF INF INF INF 40.0 960.0 units box
group  g_gage region gage
34733 atoms in group g_gage
group  g_gage_mobile intersect g_gage g_mobile
34733 atoms in group g_gage_mobile

# -----------------------------
# Hold bottom grip; zero velocity
# -----------------------------
fix f_hold g_bot setforce 0.0 0.0 0.0
velocity g_bot set 0.0 0.0 0.0

# -----------------------------
# NVT on mobile at 1 K for 20000 steps (20 ps)
# -----------------------------
fix f_nvt g_mobile nvt temp 1.0 1.0 100.0
timestep 1.0
run 20000
